pch = 16, cex = 1.1,
xlab = expression(X[1]),
ylab = expression(X[2]),
main = "An Example")
box()
# ---- Hierarchical clustering ----
# (you can swap method = "complete" / "average" / "single")
hc <- hclust(dist(X), method = "complete")
# Choose 3 cut heights for the three panels (tune these!)
h1 <- max(hc$height) * 0.20   # low cut -> many clusters
h2 <- max(hc$height) * 0.55   # medium cut -> fewer clusters
h3 <- max(hc$height) * 0.80   # high cut -> very few clusters
# ---- Helper: color labels by cut height (base plotting approach) ----
plot_dendro_cut <- function(hc, h, main_txt = "", add_cut_line = TRUE) {
den <- as.dendrogram(hc)
# cluster membership at this cut
k <- length(unique(cutree(hc, h = h)))
memb <- cutree(hc, k = k)
# order of leaves in the dendrogram
leaf_order <- order.dendrogram(den)
memb_ord   <- memb[leaf_order]
# map membership to colors (repeats if many clusters)
pal <- c("#009E73", "#CC79A7", "#E69F00", "#56B4E9", "#F0E442", "#0072B2", "#D55E00")
lab_cols <- pal[(as.integer(factor(memb_ord)) - 1) %% length(pal) + 1]
# apply colored labels
labels(den) <- rep("", length(labels(den)))  # hide labels for clean look
plot(den, main = main_txt, ylab = "", xlab = "", axes = FALSE)
axis(2)
# draw colored "rug" at bottom like your slide (colored leaves)
usr <- par("usr")
y0 <- usr[3]
y1 <- usr[3] + 0.10 * (usr[4] - usr[3])  # height of colored ticks
xs <- seq_along(leaf_order)
segments(x0 = xs, y0 = y0, x1 = xs, y1 = y1, col = lab_cols, lwd = 2)
if (add_cut_line) {
abline(h = h, lty = 2)
}
box()
}
# ---- Plot 2: Three dendrogram panels (like your slide) ----
par(mfrow = c(1,3), mar = c(2,2,3,1))
plot_dendro_cut(hc, h1, main_txt = "")
plot_dendro_cut(hc, h2, main_txt = "", add_cut_line = TRUE)
plot_dendro_cut(hc, h3, main_txt = "", add_cut_line = TRUE)
mtext("Application of hierarchical clustering", side = 3, line = 1.2, outer = TRUE, cex = 1.2)
# =========================
# Example for Hierarchical Clustering
# (scatter + 3 dendrogram cuts)
# =========================
set.seed(123)
# ---- Simulate 3 clusters in 2D (45 points total) ----
n <- c(15, 15, 15)
mu1 <- c(-5.0,  0.2)   # left cluster
mu2 <- c( 0.0,  0.0)   # middle/lower cluster
mu3 <- c( 1.5,  3.2)   # upper-right cluster
sd1 <- c(0.9, 0.9)
sd2 <- c(0.8, 0.8)
sd3 <- c(0.8, 0.9)
X1 <- cbind(rnorm(n[1], mu1[1], sd1[1]), rnorm(n[1], mu1[2], sd1[2]))
X2 <- cbind(rnorm(n[2], mu2[1], sd2[1]), rnorm(n[2], mu2[2], sd2[2]))
X3 <- cbind(rnorm(n[3], mu3[1], sd3[1]), rnorm(n[3], mu3[2], sd3[2]))
X  <- rbind(X1, X2, X3)
colnames(X) <- c("X1","X2")
true_class <- factor(rep(1:3, times = n))
cols_true  <- c("#009E73", "#CC79A7", "#E69F00")  # green, pink, orange (like your slide)
# ---- Plot 1: Scatter (true colors, but you will say labels are unknown) ----
par(mfrow = c(1,1), mar = c(4,4,2,1))
plot(X[,1], X[,2],
col = cols_true[true_class],
pch = 16, cex = 1.1,
xlab = expression(X[1]),
ylab = expression(X[2]),
main = "An Example")
box()
# ---- Hierarchical clustering ----
# (you can swap method = "complete" / "average" / "single")
hc <- hclust(dist(X), method = "complete")
# Choose 3 cut heights for the three panels (tune these!)
h1 <- max(hc$height) * 0.55   # low cut -> many clusters
h2 <- max(hc$height) * 0.8   # medium cut -> fewer clusters
h3 <- max(hc$height) * 1   # high cut -> very few clusters
# ---- Helper: color labels by cut height (base plotting approach) ----
plot_dendro_cut <- function(hc, h, main_txt = "", add_cut_line = TRUE) {
den <- as.dendrogram(hc)
# cluster membership at this cut
k <- length(unique(cutree(hc, h = h)))
memb <- cutree(hc, k = k)
# order of leaves in the dendrogram
leaf_order <- order.dendrogram(den)
memb_ord   <- memb[leaf_order]
# map membership to colors (repeats if many clusters)
pal <- c("#009E73", "#CC79A7", "#E69F00", "#56B4E9", "#F0E442", "#0072B2", "#D55E00")
lab_cols <- pal[(as.integer(factor(memb_ord)) - 1) %% length(pal) + 1]
# apply colored labels
labels(den) <- rep("", length(labels(den)))  # hide labels for clean look
plot(den, main = main_txt, ylab = "", xlab = "", axes = FALSE)
axis(2)
# draw colored "rug" at bottom like your slide (colored leaves)
usr <- par("usr")
y0 <- usr[3]
y1 <- usr[3] + 0.10 * (usr[4] - usr[3])  # height of colored ticks
xs <- seq_along(leaf_order)
segments(x0 = xs, y0 = y0, x1 = xs, y1 = y1, col = lab_cols, lwd = 2)
if (add_cut_line) {
abline(h = h, lty = 2)
}
box()
}
# ---- Plot 2: Three dendrogram panels (like your slide) ----
par(mfrow = c(1,3), mar = c(2,2,3,1))
plot_dendro_cut(hc, h3, main_txt = "")
plot_dendro_cut(hc, h2, main_txt = "", add_cut_line = TRUE)
plot_dendro_cut(hc, h1, main_txt = "", add_cut_line = TRUE)
mtext("Application of hierarchical clustering", side = 3, line = 1.2, outer = TRUE, cex = 1.2)
