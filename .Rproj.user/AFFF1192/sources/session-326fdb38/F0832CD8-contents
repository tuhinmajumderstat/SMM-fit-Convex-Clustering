#### Model 1 ####

## CVX Confusion Matrix ##

percents <- c(5,10,25)
aggregate_df <- data.frame("percent"=percents)
aggregate_df$missclassification <- 0 
aggregate_df$method <- "CVX"
for(i in 1:3)
{
  err <- 1-sum(diag(readRDS(paste0("Results-Real Data/Confusion Matrices/Convex Clustering Approach/Confusion_Matrix_",percents[i],"_Percent_model_1.rds"))))/500
  aggregate_df$missclassification[i] = err
}

## Other methods ##

compared_methods <- c("dpmm","xiong","ggl","kmeans")
compared_methods_renamed <- setNames(c("GSDPMM","Xiong","GGL","K-means"),compared_methods )
for(method in compared_methods)
{
  summary_df <- data.frame("percent"=percents)
  summary_df$missclassification <- 0 
  summary_df$method <- compared_methods_renamed[[method]]
  
  for(i in 1:3)
  {
    err <- 1-sum(diag(readRDS(paste0("Results-Real Data/Confusion Matrices/Compared Methods/Confusion_MX_",percents[i],"_model_1_method_",method,".rds"))))/500
    summary_df$missclassification[i]=err
  }
  aggregate_df <- rbind(aggregate_df,summary_df)
}


library(ggplot2)
library(grid)
library(dplyr)


# Color: distinct, colorblind-friendly palette
method_colors <- c(
  "CVX" = "#e7298a",
  "GSDPMM"                 = "#66a61e",
  "Xiong"                  = "#e6ab02",
  "GGL"                    = "#a6761d",
  "K-means"                = "#666666"
)

# Linetypes: consistent, 8-style
method_linetypes <- c(
  "CVX"="twodash",
  "GSDPMM" = "solid",
  "Xiong"  = "dashed",
  "GGL"    = "dotted",
  "K-means"= "longdash"
)

method_labels <- c(
  "CVX-Uniform_Weight" = "CVX (Uniform)",
  "CVX_knn_5_weight_l_2" = expression(CVX~"(k=5,"~l[2]*")"),
  "CVX_knn_3_weight_l_2" = expression(CVX~"(k=3,"~l[2]*")"),
  "CVX_knn_5_weight_l_inf" = expression(CVX~"(k=5,"~l[infinity]*")"),
  "CVX_knn_3_weight_l_inf" = expression(CVX~"(k=3,"~l[infinity]*")"),
  "Weylandt" = "Weylandt et al. (2020)",
  "Xiong" = "Xiong et al. (2016)"
)

theme_clean <- theme_bw() +
  theme(
    panel.grid = element_blank(),
    panel.border = element_blank(),
    axis.line = element_line(color = "black"),
    
    # REMOVE big titles (use caption instead)
    plot.title = element_text(size = 14, face = "bold"),
    
    # Proper journal-sized fonts
    axis.title = element_text(size = 12, face = "bold"),
    axis.text = element_text(size = 10),
    
    legend.title = element_text(size = 12, face = "bold"),
    legend.text = element_text(size = 10),
    
    legend.position = "bottom"
  )


plot1_df <- aggregate_df %>% filter(method %in% names(method_colors))
plot1_df$method <- factor(
  plot1_df$method,
  levels = c(
    "CVX",
    "GSDPMM",
    "GGL",
    "Xiong",  
     "K-means"
  )
)

p_model1 <- ggplot(plot1_df, aes(x = percent, y = 100*missclassification, color = method, linetype = method)) +
  geom_line(linewidth = 1) +
  labs(x = "Percentage of Available Genome Sequence", y = "Misclassification Rate (%)",
       title = "Classification for Viral Genome Sequences: Model 1",color="Method",linetype="Method") +
  scale_color_manual(
    values = method_colors,
    labels = method_labels
  ) +
  scale_linetype_manual(
    values = method_linetypes,
    labels = method_labels
  ) +
  theme_clean + 
  theme(legend.position = "bottom",
        
        legend.key.width = unit(1.5, "cm"),
        legend.spacing.x = unit(2, 'cm'))+
  guides(
    color = guide_legend(nrow = 2),
    linetype = guide_legend(nrow = 2)
  )

p_model1
ggsave("Figures/plot_missclassification_model_1.jpeg",p_model1,height=4.5,width=5.6,dpi=1200)


