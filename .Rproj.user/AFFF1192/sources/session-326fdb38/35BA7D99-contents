set.seed(12345)

n <- 100
X <- runif(n,5,10)
Y=2+3*X+rnorm(n,0,2)
model <- lm(Y~X)

plot(X,Y)
abline(model, col = "red", lwd = 2)

a_0 <- 5
b_0 <- 7

w_0=1/abs(Y-a_0-b_0*X)

max_iter=1000
eps=1e-5
iter=1
while(iter<max_iter)
{
  b_1=(sum(w_0*X*Y)*sum(w_0)-sum(w_0*X)*sum(w_0*Y))/(sum(w_0*X^2)*sum(w_0)-(sum(w_0*X))^2)
  a_1=(sum(w_0*Y)-b_1*sum(X*w_0))/sum(w_0)
  err1 <- abs((a_1-a_0)/a_0)
  err2 <- abs((b_1-b_0)/b_0)
  err <- max(err1,err2)
  if(err>eps)
  {
    a_0=a_1
    b_0=b_1
    iter=iter+1
  }else{
    break
  }
}
